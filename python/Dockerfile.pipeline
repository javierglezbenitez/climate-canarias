# Imagen de los jobs de procesado (silver y gold): Python + Java (validador NetCDF).
# IMPORTANTE: el contexto de construcción es la RAÍZ del repositorio, porque el
# Dockerfile necesita tanto java/ como python/:
#   docker build -t climate-pipeline:0.2.0 -f python/Dockerfile.pipeline .
#
# El ENTRYPOINT por defecto ejecuta la capa silver. El Job de gold lo sustituye
# con `command: ["python", "gold_indicators.py"]`.

# --- Etapa 1: compila el validador Java ---
FROM maven:3.9-eclipse-temurin-17 AS jar
WORKDIR /build
COPY java/pom.xml .
COPY java/src ./src
RUN mvn -q -B package

# --- Etapa 2: imagen final ---
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY python/requirements-pipeline.txt .
RUN pip install -r requirements-pipeline.txt

COPY --from=jar /build/target/nc-validator.jar /app/nc-validator.jar
COPY python/s3_util.py python/silver_transform.py python/gold_indicators.py ./

USER 10001

ENTRYPOINT ["python", "silver_transform.py"]
