# Imagen única de la plataforma: sirve a los Jobs de silver y gold Y como imagen de código
# de usuario de Dagster. Incluye Python, Java (validador NetCDF) y el código de orquestación.
# IMPORTANTE: el contexto de construcción es la RAÍZ del repositorio:
#   docker build -t climate-pipeline:0.3.0 -f python/Dockerfile.pipeline .
#
# No define ENTRYPOINT a propósito: el chart de Dagster arranca el servidor gRPC con sus
# propios argumentos, y los Jobs de Kubernetes indican `command` de forma explícita.

# --- Etapa 1: compila el validador Java ---
FROM maven:3.9-eclipse-temurin-17 AS jar
WORKDIR /build
COPY java/pom.xml .
COPY java/src ./src
RUN mvn -q -B package

# --- Etapa 2: imagen final ---
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app \
    HOME=/tmp

RUN apt-get update \
    && apt-get install -y --no-install-recommends default-jre-headless \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY python/requirements-pipeline.txt .
RUN pip install -r requirements-pipeline.txt

COPY --from=jar /build/target/nc-validator.jar /app/nc-validator.jar
COPY python/cds_common.py python/s3_util.py python/ingest_bronze.py \
     python/silver_transform.py python/gold_indicators.py ./
COPY orchestration ./orchestration
